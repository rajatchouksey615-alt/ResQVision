# Safe local-development placeholders only. Copy to a private local .env file
# and replace the local-only values before starting services. Never commit it.
APP_ENV=development

# Django backend
DJANGO_SECRET_KEY=replace-with-a-local-only-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000

# PostgreSQL local development
POSTGRES_DB=resqvision_dev
POSTGRES_USER=resqvision_app
POSTGRES_PASSWORD=replace-with-a-local-only-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# Human API JWT. Replace with a unique random value of at least 32 characters
# for any shared environment; it must differ from DJANGO_SECRET_KEY.
JWT_SIGNING_KEY=replace-with-a-separate-random-local-only-key

# AI service; OAD-017 is unresolved, so no machine credential is configured.
AI_SERVICE_BASE_URL=http://localhost:8001

# Provider selection is pending. Keep keys empty until approved and configured.
MAP_PROVIDER=pending
MAPS_API_KEY=
OBJECT_STORAGE_PROVIDER=pending
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=

# Firebase Cloud Messaging is planned; no project or credentials are selected.
FIREBASE_PROJECT_ID=pending
FIREBASE_CREDENTIALS_PATH=
